diff --git a/src/kernel/xboxkrnl/xboxkrnl_io.cpp b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
index 3f1a852..42f3c40 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_io.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_io.cpp
@@ -149,6 +149,27 @@ u32 NtCreateFile_entry(mapped_u32 handle_out, u32 desired_access,
       root_entry, target_path, rex::filesystem::FileDisposition((uint32_t)creation_disposition),
       desired_access, (create_options & CreateOptions::FILE_DIRECTORY_FILE) != 0,
       (create_options & CreateOptions::FILE_NON_DIRECTORY_FILE) != 0, &vfs_file, &file_action);
+
+  // OutRun Online Arcade probes an unpacked .gpu project first and expects the
+  // retail compressed .gpz file to be used when it is absent. Its original
+  // filesystem layer performs this fallback before returning to the caller.
+  // Reproduce that behavior here so the caller receives a valid file object
+  // and can initialize the menu's GPU resources.
+  if (XFAILED(result) && target_path.size() >= 4 &&
+      target_path.compare(target_path.size() - 4, 4, ".gpu") == 0) {
+    auto compressed_path = target_path;
+    compressed_path.back() = 'z';
+    result = REX_KERNEL_FS()->OpenFile(
+        root_entry, compressed_path,
+        rex::filesystem::FileDisposition((uint32_t)creation_disposition), desired_access,
+        (create_options & CreateOptions::FILE_DIRECTORY_FILE) != 0,
+        (create_options & CreateOptions::FILE_NON_DIRECTORY_FILE) != 0, &vfs_file, &file_action);
+    if (XSUCCEEDED(result)) {
+      REXKRNL_IMPORT_RESULT("NtCreateFile", "fallback '{}' -> '{}'", target_path,
+                            compressed_path);
+      target_path = std::move(compressed_path);
+    }
+  }
   object_ref<XFile> file = nullptr;
 
   X_HANDLE handle = X_INVALID_HANDLE_VALUE;
diff --git a/src/kernel/xboxkrnl/xboxkrnl_memory.cpp b/src/kernel/xboxkrnl/xboxkrnl_memory.cpp
index 8684eda..c087fd8 100644
--- a/src/kernel/xboxkrnl/xboxkrnl_memory.cpp
+++ b/src/kernel/xboxkrnl/xboxkrnl_memory.cpp
@@ -126,9 +126,12 @@ u32 NtAllocateVirtualMemory_entry(mapped_u32 base_addr_ptr, mapped_u32 region_si
 
   // Round the base address down to the nearest page boundary.
   uint32_t adjusted_base = *base_addr_ptr - (*base_addr_ptr % page_size);
-  // For some reason, some games pass in negative sizes.
-  uint32_t adjusted_size =
-      int32_t(*region_size_ptr) < 0 ? -int32_t(region_size_ptr.value()) : region_size_ptr.value();
+  // For some reason, some games pass in negative sizes. Use the value stored
+  // at the guest pointer, not the guest address of the pointer itself.
+  const uint32_t requested_size = *region_size_ptr;
+  uint32_t adjusted_size = int32_t(requested_size) < 0
+                               ? uint32_t(-int64_t(int32_t(requested_size)))
+                               : requested_size;
   // Use 64KB allocation granularity when no base address is specified,
   // matching Xbox 360 behavior. With a base address, use the heap's page size.
   adjusted_size = rex::round_up(adjusted_size, adjusted_base ? page_size : 64 * 1024);
