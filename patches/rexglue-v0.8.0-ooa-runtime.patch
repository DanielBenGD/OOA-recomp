+if(MINGW)
+    # Guest hooks are implemented with source-level names beginning "__imp__".
+    # In PE/COFF that prefix denotes an IAT slot, so calling such a symbol
+    # directly executes non-executable .rdata (BEX64). Export a safe thunk name
+    # for generated MinGW code, plus the conventional MSVC-compatible alias.
+    set(REX_KERNEL_EXPORT_DEF "${CMAKE_CURRENT_BINARY_DIR}/rex_kernel_exports.def")
+    set(REX_KERNEL_EXPORT_SYMBOLS)
+    foreach(REX_KERNEL_SOURCE IN LISTS REXKERNEL_SOURCES)
+        file(READ "${REX_KERNEL_SOURCE}" REX_KERNEL_SOURCE_TEXT)
+        string(REGEX MATCHALL "__imp__[A-Za-z0-9_]+" REX_SOURCE_EXPORTS
+               "${REX_KERNEL_SOURCE_TEXT}")
+        list(APPEND REX_KERNEL_EXPORT_SYMBOLS ${REX_SOURCE_EXPORTS})
+    endforeach()
+    list(REMOVE_DUPLICATES REX_KERNEL_EXPORT_SYMBOLS)
+    file(WRITE "${REX_KERNEL_EXPORT_DEF}" "EXPORTS\n")
+    foreach(REX_KERNEL_EXPORT IN LISTS REX_KERNEL_EXPORT_SYMBOLS)
+        string(REGEX REPLACE "^__imp_" "" REX_KERNEL_IMPORT_NAME
+               "${REX_KERNEL_EXPORT}")
+        file(APPEND "${REX_KERNEL_EXPORT_DEF}"
+             "  ${REX_KERNEL_IMPORT_NAME}=${REX_KERNEL_EXPORT}\n")
+        file(APPEND "${REX_KERNEL_EXPORT_DEF}"
+             "  rex_${REX_KERNEL_EXPORT}=${REX_KERNEL_EXPORT}\n")
+    endforeach()
+    target_sources(rexruntime PRIVATE "${REX_KERNEL_EXPORT_DEF}")
+endif()
+
 target_link_libraries(rexruntime PRIVATE o1heap rexcore rexfilesystem rexgraphics rexui rexaudio rexinput imgui)
