diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
index efed1b7..08cd4e9 100644
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2526,6 +2526,17 @@ bool D3D12CommandProcessor::IssueDraw(xenos::PrimitiveType primitive_type, uint3
               vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1);
           return false;
         default:
+          // OutRun Online Arcade reuses a fetch group as a texture while a
+          // statically referenced vertex fetch in the same shader is inactive.
+          // Interpreting the texture bits as a vertex address produces huge,
+          // wrapped ranges. With the compatibility option, skip residency for
+          // this inactive mismatched slot instead of treating garbage as a
+          // valid vertex buffer. Register writes invalidate the bit again if
+          // the slot later becomes a real vertex fetch.
+          if (REXCVAR_GET(gpu_allow_invalid_fetch_constants)) {
+            vertex_buffers_in_sync_[vfetch_index >> 6] |= vfetch_bit;
+            continue;
+          }
           REXGPU_WARN("Vertex fetch constant {} ({:08X} {:08X}) is completely invalid!",
                       vfetch_index, vfetch_constant.dword_0, vfetch_constant.dword_1);
           return false;
